{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["./opencode-maas-env.ts"],
  "model": "huawei-maas/glm-5.3",
  "small_model": "huawei-maas/glm-5.3",
  "provider": {
    "huawei-maas": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Huawei Cloud MaaS",
      "env": ["MAAS_API_KEY"],
      "options": {
        "baseURL": "https://api-ap-southeast-1.modelarts-maas.com/v2",
        "apiKey": "{env:MAAS_API_KEY}"
      },
      "models": {
        "glm-5.3": {
          "name": "GLM-5.3",
          "reasoning": true,
          "tool_call": true,
          "interleaved": { "field": "reasoning_content" },
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        }
      }
    }
  }
}
