#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [[ ! -r "$project_dir/.env" ]]; then
  printf 'Missing credentials file: %s/.env\n' "$project_dir" >&2
  exit 1
fi

set -a
source "$project_dir/.env"
set +a
: "${MAAS_API_KEY:?Set MAAS_API_KEY in .env}"

cd -- "$project_dir"
exec opencode "$@"
